		<variableExpression><![CDATA[]]></variableExpression>
	</variable>
	<variable name="v_sum_of_amount" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[]]></variableExpression>
	</variable>
	<variable name="v_sum_of_VATamount" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{v_VAT_amount}]]></variableExpression>
	</variable>
	<variable name="v_sum_of_totwithVAT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{v_Total_with_VAT}]]></variableExpression>
	</variable>
	<variable name="v_sum_of_min" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[]]></variableExpression>
	</variable>
	<variable name="v_sum_of_two" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[]]></variableExpression>
	</variable>
	<variable name="DateDifference" class="java.lang.Number">
		<variableExpression><![CDATA[$F{PAID_DATE} -$F{PIV1_DATE}]]></variableExpression>
	</variable>
