	<field name="op_sbal" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="dr_samt" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="cr_samt" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="cl_sbal" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="cct_name" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<variable name="SUM_op_sbal_1" class="java.math.BigDecimal" resetType="Group" resetGroup="GROUP_DR_CR" calculation="Sum">
		<variableExpression><![CDATA[$F{op_sbal}]]></variableExpression>
	</variable>
	<variable name="SUM_dr_samt_1" class="java.math.BigDecimal" resetType="Group" resetGroup="GROUP_DR_CR" calculation="Sum">
		<variableExpression><![CDATA[$F{dr_samt}]]></variableExpression>
	</variable>
	<variable name="SUM_cr_samt_1" class="java.math.BigDecimal" resetType="Group" resetGroup="GROUP_DR_CR" calculation="Sum">
		<variableExpression><![CDATA[$F{cr_samt}]]></variableExpression>
	</variable>
	<variable name="SUM_cl_sbal_1" class="java.math.BigDecimal" resetType="Group" resetGroup="GROUP_DR_CR" calculation="Sum">
		<variableExpression><![CDATA[$F{cl_sbal}]]></variableExpression>
	</variable>
	<variable name="actual_Expenditure_MAX" class="java.math.BigDecimal" incrementType="Group" incrementGroup="GROUP_DR_CR" calculation="Variance">
		<variableExpression><![CDATA[$V{SUM_op_sbal_1}]]></variableExpression>
	</variable>
	<variable name="actual_Expenditure_MIN" class="java.math.BigDecimal" calculation="Lowest">
		<variableExpression><![CDATA[$V{SUM_op_sbal_1}]]></variableExpression>
	</variable>
