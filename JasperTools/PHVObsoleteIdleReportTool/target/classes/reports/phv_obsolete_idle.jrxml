<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="PHV_Obsolete_Idle"
              pageWidth="842"
              pageHeight="595"
              orientation="Landscape"
              whenNoDataType="AllSectionsNoDetail"
              columnWidth="802"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">
    <property name="ireport.encoding" value="UTF-8"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.band.1" value="pageFooter"/>
    <import value="java.util.*"/>

    <parameter name="costctr" class="java.lang.String"/>
    <parameter name="whcode" class="java.lang.String"/>
    <parameter name="repYear" class="java.lang.Integer"/>
    <parameter name="repMonth" class="java.lang.Integer"/>

    <field name="documentNo" class="java.lang.String"/>
    <field name="materialCode" class="java.lang.String"/>
    <field name="materialName" class="java.lang.String"/>
    <field name="gradeCode" class="java.lang.String"/>
    <field name="phvDate" class="java.lang.String"/>
    <field name="qtyOnHand" class="java.lang.Double"/>
    <field name="stockBook" class="java.lang.Double"/>
    <field name="reason" class="java.lang.String"/>

    <variable name="v_Item_No" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$V{REPORT_COUNT}]]></variableExpression>
    </variable>

    <variable name="Sum_SBV" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{stockBook}]]></variableExpression>
    </variable>

    <title>
        <band height="35">
            <textField>
                <reportElement x="0" y="0" width="802" height="18"/>
                <textElement textAlignment="Center">
                    <font fontName="Arial" size="12" isBold="true" isUnderline="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <textFieldExpression><![CDATA["STATEMENT OF OBSOLETE  AND IDLE MATERIALS IN STOCKS - " + $P{repYear} + "  Cost Center : " + $P{costctr}.replaceAll("'", "") + " WARE HOUSE - " + $P{whcode}.replaceAll("'", "")]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <pageHeader>
        <band height="70">
            <staticText><reportElement x="0" y="52" width="25" height="18"/><textElement textAlignment="Center"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[SerialNo]]></text></staticText>
            <staticText><reportElement x="25" y="52" width="80" height="18"/><textElement textAlignment="Center"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Code No]]></text></staticText>
            <staticText><reportElement x="105" y="52" width="215" height="18"/><textElement textAlignment="Center"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
            <staticText><reportElement x="320" y="52" width="55" height="18"/><textElement textAlignment="Center"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Grade Code]]></text></staticText>
            <staticText><reportElement x="375" y="52" width="70" height="18"/><textElement textAlignment="Center"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Quantity]]></text></staticText>
            <staticText><reportElement x="445" y="52" width="95" height="18"/><textElement textAlignment="Center"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Cost (Rs.)]]></text></staticText>
            <staticText><reportElement x="540" y="52" width="262" height="18"/><textElement textAlignment="Center"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Reasons]]></text></staticText>
            <textField>
                <reportElement x="0" y="0" width="802" height="18"/>
                <textElement textAlignment="Left"><font fontName="Arial" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Date of Verification : " + ($F{phvDate} == null ? ".............." : $F{phvDate})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="18" width="380" height="16"/>
                <textElement textAlignment="Left"><font fontName="Arial" size="10"/></textElement>
                <textFieldExpression><![CDATA["1.ORIGINAL  :  Deputy General Manager"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="34" width="380" height="16"/>
                <textElement textAlignment="Left"><font fontName="Arial" size="10"/></textElement>
                <textFieldExpression><![CDATA["2.DUPLICATE :  Engineer-in-charge"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="382" y="18" width="420" height="16"/>
                <textElement textAlignment="Left"><font fontName="Arial" size="10"/></textElement>
                <textFieldExpression><![CDATA["We do hereby certify that Stocks were physically verfied"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="382" y="34" width="420" height="16"/>
                <textElement textAlignment="Left"><font fontName="Arial" size="10"/></textElement>
                <textFieldExpression><![CDATA["as per that given statment."]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <detail>
        <band height="22">
            <textField><reportElement x="0" y="0" width="25" height="22"/><textElement textAlignment="Center"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$V{v_Item_No}]]></textFieldExpression></textField>
            <textField><reportElement x="25" y="0" width="80" height="22"/><textElement textAlignment="Center"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{documentNo}]]></textFieldExpression></textField>
            <textField><reportElement x="105" y="0" width="215" height="22"/><textElement textAlignment="Left"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{materialName}]]></textFieldExpression></textField>
            <textField><reportElement x="320" y="0" width="55" height="22"/><textElement textAlignment="Center"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{gradeCode}]]></textFieldExpression></textField>
            <textField><reportElement x="375" y="0" width="70" height="22"/><textElement textAlignment="Right"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{qtyOnHand}]]></textFieldExpression></textField>
            <textField><reportElement x="445" y="0" width="95" height="22"/><textElement textAlignment="Right"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{stockBook}]]></textFieldExpression></textField>
            <textField><reportElement x="540" y="0" width="262" height="22"/><textElement textAlignment="Left"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{reason}]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField><reportElement x="0" y="2" width="350" height="14"/><textElement><font fontName="Arial" size="7" isBold="true"/></textElement><textFieldExpression><![CDATA["Date & time of the Report Generated : " + new java.util.Date()]]></textFieldExpression></textField>
            <textField><reportElement x="730" y="2" width="72" height="14"/><textElement textAlignment="Right"><font fontName="Arial" size="7" isBold="true"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of "]]></textFieldExpression></textField>
            <textField evaluationTime="Report"><reportElement x="802" y="2" width="20" height="14"/><textElement><font fontName="Arial" size="7" isBold="true"/></textElement><textFieldExpression><![CDATA["" + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
        </band>
    </pageFooter>

    <summary>
        <band height="26">
            <staticText><reportElement x="0" y="0" width="445" height="18"/><textElement textAlignment="Right"><font fontName="Arial" size="10" isBold="true"/></textElement><text><![CDATA[Total Stocks]]></text></staticText>
            <textField><reportElement x="445" y="0" width="95" height="18"/><textElement textAlignment="Right"><font fontName="Arial" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{Sum_SBV}]]></textFieldExpression></textField>
        </band>
    </summary>
</jasperReport>