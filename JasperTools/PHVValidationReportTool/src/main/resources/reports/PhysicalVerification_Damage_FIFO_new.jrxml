	<property name="ireport.y" value="0"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="@costctr" class="java.lang.String"/>
	<parameter name="@repyear" class="java.lang.Integer"/>
	<parameter name="@repmonth" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="@whcode" class="java.lang.String"/>
	<queryString>
		<![CDATA[select f.doc_no,f.MAT_CD,m.MAT_NM,f.grade_cd  ,f.doc_dt as phv_dt  ,sum(Case when  f.damage_count > 0 then f.damage_count else f.COUNTED_QTY end )  as QTY_ON_HAND  ,sum(f.UNIT_PRICE * (Case when  f.damage_count > 0 then f.damage_count else f.COUNTED_QTY end ))as StockBook,f.REASON,
( select dept_nm from gldeptm where dept_id=$P!{@costctr} ) as cct_name  from fifo_phv f, inmatm M
 where   trim(f.mat_cd) = trim(m.mat_cd) and(  f.damage_count > 0 or trim(f.GRADE_CD)='DAM' or trim(f.GRADE_CD)='DMG')   and f.dept_id= $P!{@costctr}  and f.status=$P!{@repyear} and f.wrh_cd=$P!{@whcode}
group by f.doc_no,f.MAT_CD,Case when  f.damage_count > 0 then f.damage_count else f.COUNTED_QTY end,m.MAT_NM,f.grade_cd ,f.REASON,f.doc_dt
order by f.doc_no,f.MAT_CD]]>
	</queryString>
	<field name="DOC_NO" class="java.lang.String"/>
	<field name="MAT_CD" class="java.lang.String"/>
	<field name="MAT_NM" class="java.lang.String"/>
	<field name="GRADE_CD" class="java.lang.String"/>
	<field name="PHV_DT" class="java.sql.Timestamp"/>
	<field name="QTY_ON_HAND" class="java.math.BigDecimal"/>
	<field name="STOCKBOOK" class="java.math.BigDecimal"/>
	<field name="REASON" class="java.lang.String"/>
	<field name="CCT_NAME" class="java.lang.String"/>
	<variable name="v_Item_No" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$V{REPORT_COUNT}]]></variableExpression>
	</variable>
	<variable name="Sum_SBV" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{STOCKBOOK}]]></variableExpression>
	</variable>
