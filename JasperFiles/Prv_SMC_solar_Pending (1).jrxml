				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Branch/ Province : "+ $P{@compId}.replaceAll( "'", "" )+" / " +  $F{COMP_NM}.trim()]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="false">
				<reportElement key="textField-1" x="0" y="0" width="1080" height="22"/>
