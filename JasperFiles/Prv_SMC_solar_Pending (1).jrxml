	<subDataset name="prjCosting">
		<queryString>
			<![CDATA[select unique  "Project Costing" as Category,
       T1.doc_no,
       T1.doc_pf,
       T1.doc_dt,
       T1.ent_by,
       T1.modi_by,
       T3.project_no,
       (case  when T1.status=1 then 'Job not updated'
             when T1.status=2 then 'Job Updated. But not posted to GL'
       else NULL end ) as tranStatus ,
       T1.dept_id
from  pctrxhmt T1 , pctrxdmt T3
where (T1.status =1 or T1.status=2) and
      T1.doc_no=T3.doc_no  and
      T1.doc_pf= T3.doc_pf and
      T1.doc_dt>=DATETIME( 2009-01-01 ) YEAR TO DAY and
      T1.doc_dt<=DATETIME( 2009-08-31) YEAR TO DAY  and
      not (T1.doc_no )   in (select T2.doc_no
                               from glvochmt T2
                              where T2.dept_id='510.20'    )
order by   T1.doc_pf ,T1.doc_no , T1.doc_dt]]>
		</queryString>
