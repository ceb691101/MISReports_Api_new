		</field>
		<field name="project_no" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="transtatus" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="dept_id" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
	</subDataset>
	<subDataset name="matRequisition">
		<queryString>
			<![CDATA[select "Material  Requisition " as Category,
       doc_no,
       doc_pf,
       req_dt,
       ent_by,
       modi_by,
       apr_uid_1,
       (case  when status=4 then 'Issue Generated'
             when status=6 then 'Issue Posting'
             when status=7 then 'Requisition Confirm '
             when status=9 then 'Posted Cancellation '
       else NULL end  ) as tranStatus
from mtreqhmt
where  status NOT  in(1,2,3,8) and
       dept_id='510.20' and
       req_dt>=DATETIME( 2009-01-01 ) YEAR TO DAY and
       req_dt<=DATETIME( 2009-08-31) YEAR TO DAY
order by   doc_pf ,doc_no , req_dt]]>
