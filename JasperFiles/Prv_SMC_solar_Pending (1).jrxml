					<font fontName="Arial" size="15" isBold="true" isUnderline="true" pdfFontName="Helvetica-Bold"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Solar Retail Roof-top Pending Jobs after PIV2 Paid - From " + $P{@fromDate}.replaceAll( "'", "" )+ " To " + $P{@toDate}.replaceAll( "'", "" )]]></textFieldExpression>
			</textField>
		</band>
