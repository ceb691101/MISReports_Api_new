	<subDataset name="IssueEntry">
		<queryString>
			<![CDATA[select  'Inventory' as Category ,
	doc_no,
        doc_pf,
        trx_dt,
        ent_by,
        modi_by,
        apprv_uid1,
        (case  when status=1 then 'New'
              when status=2 then 'Confirmed Record'
              when status=3 then 'Send for 1st. Approval'
              when status=4 then 'Posted. But not Accounted'
              when status=5 then 'Cancelled  Record'
              when status=7 then 'First Approval'
              else NULL
        end ) as tranStatus
 from intrhmt
where status <> 6 and
      dept_id='510.11' and
      trx_dt>=DATETIME( 2009-01-01 ) YEAR TO DAY and
      trx_dt<=DATETIME( 2009-08-31) YEAR TO DAY
order by   doc_pf ,doc_no , trx_dt]]>
		</queryString>
		<field name="category" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="doc_no" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="doc_pf" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="trx_dt" class="java.sql.Date">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="ent_by" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="modi_by" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="apprv_uid1" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="transtatus" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
	</subDataset>
	<subDataset name="cashBookMain">
		<queryString>
			<![CDATA[select "Cash Book- After Posting" as Category,
       doc_no,
       doc_pf,
       doc_dt,
       ent_by,
       modi_by,
       apprv_uid1,
       (case  when status=1 then 'New'
             when status=2 then 'Send for Approval'
             when status=3 then 'Approved'
             when status=6 then 'To be cancelled'
             when status=5 then 'Cancelled  Record'
             when status=7 then 'Payment Plan generated '
             else NULL
       end ) as tranStatus
 from cbpmthmt
where NOT ( status = 4 or status = 8) and
      dept_id='970.00' and
      doc_dt>=DATETIME( 2009-01-01 ) YEAR TO DAY and
      doc_dt<=DATETIME( 2009-08-31) YEAR TO DAY
order by   doc_pf ,doc_no , doc_dt]]>
		</queryString>
