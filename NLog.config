<?xml version="1.0" encoding="utf-8" ?>
<!--
  MISReports_Api logging configuration (NLog 6.x)

  IMPORTANT: Do NOT install / reinstall the "NLog.Config" NuGet package.
  That package only ships a blank template NLog.config and will silently
  overwrite this file, which turns off all logging (this happened in
  commit 2ada7cb, 01-Jul-2026).

  Output (one file per day, per type) in <site root>/logs :
    app-yyyy-MM-dd.log    Info, Warn, Error, Fatal from the whole API
    error-yyyy-MM-dd.log  Error and Fatal only (with thread id + full stack trace)
    debug-yyyy-MM-dd.log  Debug and above from the DAL layer

  Retention: files older than 7 days are deleted automatically by NLog
  (maxArchiveDays / maxArchiveFiles). Cleanup runs when NLog starts the
  next day's file, i.e. on the first log write of each day.

  Each target uses its own file-name prefix on purpose: NLog builds the
  cleanup wildcard from fileName (e.g. app-*.log), so distinct prefixes
  stop one target's cleanup from counting or deleting another target's files.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      throwConfigExceptions="false"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.log">

	<variable name="logDirectory" value="${basedir}/logs" />
	<variable name="logFormat" value="${longdate} | ${level:uppercase=true:padding=5} | ${logger:shortName=true} | ${message} ${exception:format=ToString}" />
	<variable name="detailedFormat" value="${longdate} | ${level:uppercase=true:padding=5} | ${logger} | ${threadid} | ${message} ${exception:format=ToString}" />

	<targets async="true">

		<!-- Main application log: one file per day, kept for 7 days -->
		<target name="mainFile" xsi:type="File"
				fileName="${logDirectory}/app-${shortdate}.log"
				layout="${logFormat}"
				maxArchiveDays="7"
				maxArchiveFiles="7"
				keepFileOpen="false"
				encoding="utf-8" />

		<!-- Errors only: one file per day, kept for 7 days -->
		<target name="errorFile" xsi:type="File"
				fileName="${logDirectory}/error-${shortdate}.log"
				layout="${detailedFormat}"
				maxArchiveDays="7"
				maxArchiveFiles="7"
				keepFileOpen="false"
				encoding="utf-8" />

		<!-- DAL debug log: one file per day, kept for 7 days -->
		<target name="debugFile" xsi:type="File"
				fileName="${logDirectory}/debug-${shortdate}.log"
				layout="${detailedFormat}"
				maxArchiveDays="7"
				maxArchiveFiles="7"
				keepFileOpen="false"
				encoding="utf-8" />

	</targets>

	<rules>
		<!-- Everything Info and above from the API goes to the daily app log -->
		<logger name="*" minlevel="Info" writeTo="mainFile" />

		<!-- Errors are also copied to their own daily file for quick review -->
		<logger name="*" minlevel="Error" writeTo="errorFile" />

		<!-- Detailed SQL / data-access debugging for the DAL layer -->
		<logger name="MISReports_Api.DAL*" minlevel="Debug" writeTo="debugFile" />
	</rules>
</nlog>
